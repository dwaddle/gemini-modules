; screen.mac - Screen Control Macros
%ifndef SCREEN_MAC
    %define SCREEN_MAC

; Wist scherm
%macro @cls 0
    call _screen_clear
%endmacro

; Reset kleur
%macro @reset_color 0
    call _screen_reset_color
%endmacro

; Verberg cursor
%macro @hide_cursor 0
    call _screen_hide_cursor
%endmacro

; Toon cursor
%macro @show_cursor 0
    call _screen_show_cursor
%endmacro

; Stel achtergrondkleur in
%macro @bg_color 1
    mov rdi, %1
    call _screen_set_bgcolor
%endmacro

; Scroll omhoog
%macro @scroll_up 1
    mov rdi, %1
    call _screen_scroll_up
%endmacro

; Scroll omlaag
%macro @scroll_down 1
    mov rdi, %1
    call _screen_scroll_down
%endmacro

; Buffer Initialiseren
%macro @buf_init 1
    mov rdi, %1
    call _screen_buffer_init
%endmacro

; Schrijven naar Buffer
%macro @buf_write 3
    mov rdi, %1             ; X
    mov rsi, %2             ; Y
    mov rdx, %3             ; String
    call _screen_buffer_write
%endmacro

; Render Buffer
%macro @buf_render 0
    call _screen_buffer_render
%endmacro

; Scroll View
%macro @buf_scroll 1
    mov rdi, %1
    call _screen_buffer_scroll_view
%endmacro

%endif
