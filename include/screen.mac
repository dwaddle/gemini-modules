; screen.mac - Screen Control & Viewport Macros
%ifndef SCREEN_MAC
    %define SCREEN_MAC

; --- Explicitly declare extern functions used by macros ---
; These declarations help NASM resolve symbols during macro expansion.


; Viewport Structuur Offsets
%define VP_X        0
%define VP_Y        8
%define VP_W        16
%define VP_H        24
%define VP_BUF      32
%define VP_BUF_H    40
%define VP_VIEW_Y   48
%define VP_FG       56
%define VP_BG       57
%define VP_FLAGS    58
%define VP_B_FG     59
%define VP_B_BG     60
%define VP_TITLE    64
%define VP_SIZE     80

; Viewport Flags
%define VPF_BORDER      1
%define VPF_AUTOSCROLL  2
%define VPF_FOCUS       4

; Alignment Modes
%define ALIGN_LEFT      0
%define ALIGN_CENTER    1
%define ALIGN_RIGHT     2

; --- Algemene Scherm Macro's ---
%macro @cls 0
    call _screen_clear
%endmacro

%macro @reset_color 0
    call _screen_reset_color
%endmacro

; --- Viewport Specifieke Macro's ---

%macro @vp_create 5
    mov rdi, %1 ; X
    mov rsi, %2 ; Y
    mov rdx, %3 ; W
    mov rcx, %4 ; H
    mov r8,  %5 ; BufH
    call _viewport_create
%endmacro

; Kleur instellen voor viewport
; Gebruik: @vp_set_color vp_ptr, fg, bg
%macro @vp_set_color 3
    mov rdi, %1
    mov rsi, %2 ; FG
    mov rdx, %3 ; BG
    call _viewport_set_color
%endmacro

; Border aanzetten
%macro @vp_set_border 2
    mov rdi, %1
    mov rsi, %2 ; 1 = aan, 0 = uit
    call _viewport_set_border
%endmacro

; Titel instellen
%macro @vp_set_title 2
    mov rdi, %1
    mov rsi, %2
    call _viewport_set_title
%endmacro

%macro @vp_write 4
    mov rdi, %1
    mov rsi, %2
    mov rdx, %3
    mov rcx, %4
    call _viewport_write
%endmacro

%macro @vp_render 1
    mov rdi, %1
    call _viewport_render
%endmacro

%macro @screen_flip 0
    call _screen_flip
%endmacro

%macro @vp_scroll 2
    mov rdi, %1
    mov rsi, %2
    call _viewport_scroll
%endmacro

%macro @vp_clear 1
    mov rdi, %1
    call _viewport_clear
%endmacro

%macro @vp_move 3
    mov rdi, %1
    mov rsi, %2
    mov rdx, %3
    call _viewport_move
%endmacro

; Border kleur instellen
%macro @vp_set_border_color 3
    mov rdi, %1
    mov rsi, %2 ; FG
    mov rdx, %3 ; BG
    call _viewport_set_border_color
%endmacro

; Focus instellen
%macro @vp_set_focus 2
    mov rdi, %1
    mov rsi, %2 ; 1 = focus, 0 = blur
    call _viewport_set_focus
%endmacro

; Schrijf met uitlijning
%macro @vp_write_aligned 4
    mov rdi, %1 ; VP
    mov rsi, %2 ; LY
    mov rdx, %3 ; StrPtr
    mov rcx, %4 ; Mode (ALIGN_*)
    call _viewport_write_aligned
%endmacro

; Schakel autoscroll in/uit
%macro @vp_set_autoscroll 2
    mov rdi, %1
    test rsi, rsi
    jz %%disable
    or byte [rdi + VP_FLAGS], VPF_AUTOSCROLL
    jmp %%done
%%disable:
    and byte [rdi + VP_FLAGS], ~VPF_AUTOSCROLL
%%done:
%endmacro

; --- Input Box Widget Macro's ---

; Creëer een input box
; Gebruik: @input_box_create x, y, w, h, prompt_ptr, buffer_ptr, max_len
%macro @input_box_create 7
    mov rdi, %1
    mov rsi, %2
    mov rdx, %3
    mov rcx, %4
    mov r8,  %5
    mov r9,  %6
    mov r10, %7
    call _input_box_create
%endmacro

; Teken de input box
; Gebruik: @input_box_draw ib_ptr
%macro @input_box_draw 1
    mov rdi, %1
    call _input_box_draw
%endmacro

%endif
