; algemeen.mac - Core utility macros for x86_64
%ifndef ALGEMEEN_MAC
    %define ALGEMEEN_MAC

; Save all general purpose registers except RAX
%macro @save_context 0
    push rbx
    push rcx
    push rdx
    push rsi
    push rdi
    push rbp
    push r8
    push r9
    push r10
    push r11
    push r12
    push r13
    push r14
    push r15
%endmacro

%macro @restore_context 0
    pop r15
    pop r14
    pop r13
    pop r12
    pop r11
    pop r10
    pop r9
    pop r8
    pop rbp
    pop rdi
    pop rsi
    pop rdx
    pop rcx
    pop rbx
%endmacro

; Save only callee-saved registers according to System V ABI
; Registers: RBX, RBP, R12, R13, R14, R15
%macro @save_callee_saved 0
    push rbx
    push rbp
    push r12
    push r13
    push r14
    push r15
%endmacro

%macro @restore_callee_saved 0
    pop r15
    pop r14
    pop r13
    pop r12
    pop rbp
    pop rbx
%endmacro

; Safe register clear
%macro @clear 1
    xor %1, %1
%endmacro

; Exit program
%macro @exit 1
    mov rax, 60
    mov rdi, %1
    syscall
%endmacro

; Safe alignment macro
%macro @align_stack 0
    push rbp
    mov rbp, rsp
    and rsp, -16
%endmacro

%macro @restore_stack 0
    mov rsp, rbp
    pop rbp
%endmacro

; Macro for industrial error handling after a syscall
; Checks RAX for negative values (errors)
%macro @check_syscall 0
    test rax, rax
    js %%error
    jmp %%done
%%error:
    neg rax             ; Get positive error code
    ; Hier zouden we een globale panic handler kunnen aanroepen
%%done:
%endmacro

%endif
