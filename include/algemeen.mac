; algemeen.mac - Core utility macros for x86_64
%ifndef ALGEMEEN_MAC
    %define ALGEMEEN_MAC

; Save all general purpose registers except RAX
%macro @save_context 0
    push rbx
    push rcx
    push rdx
    push rsi
    push rdi
    push rbp
    push r8
    push r9
    push r10
    push r11
    push r12
    push r13
    push r14
    push r15
%endmacro

; Restore all general purpose registers except RAX
%macro @restore_context 0
    pop r15
    pop r14
    pop r13
    pop r12
    pop r11
    pop r10
    pop r9
    pop r8
    pop rbp
    pop rdi
    pop rsi
    pop rdx
    pop rcx
    pop rbx
%endmacro

; Clear a register
%macro @clear 1
    xor %1, %1
%endmacro

; Exit program
%macro @exit 1
    mov rax, 60
    mov rdi, %1
    syscall
%endmacro

%endif
